# Development / production — Neon hosted PostgreSQL (SSL required)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/spt_dev?sslmode=require
SYNC_DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx.region.aws.neon.tech/spt_dev?sslmode=require

# Testing — local PostgreSQL (no SSL required)
TEST_DATABASE_URL=postgresql+asyncpg://spt:password@localhost:5432/spt_test

SECRET_KEY=replace-with-32-random-bytes-hex
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
# Set to True in local development only; controls https_only on the session cookie
DEBUG=False

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-secure-password
ADMIN_SECRET=replace-with-32-random-bytes-hex

# Email — Mailgun (leave MAILGUN_API_KEY empty to disable email sending)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Simple Project Tool
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=

# LLM — Google Gemini (leave GOOGLE_API_KEY empty to disable capture endpoints)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_CAPTURE_MIN_CONFIDENCE=0.5
# Offline demo: LLM_PROVIDER=replay serves recorded fixtures instead of calling a
# provider, and CAPTURE_REFERENCE_DATE pins the "today" they were recorded against
# (see scripts/demo_capture.py). Leave empty in production.
CAPTURE_REFERENCE_DATE=
# Password for the accounts `scripts.demo_capture seed` creates. Leave empty and the
# script generates one and prints it once. Never set this on a real deployment.
DEMO_SEED_PASSWORD=
# Per-user BYO credentials: fall back to the server's GOOGLE_API_KEY when a user has none
LLM_ALLOW_SERVER_KEY_FALLBACK=True
LLM_MAX_RPM=20
LLM_MAX_TPM=100000

# API keys issued before the key_prefix migration have an empty prefix and need a second
# lookup bucket, which is scanned for any key matching no prefix. Rotate those keys —
#   SELECT count(*) FROM api_keys WHERE key_prefix = '' AND revoked_at IS NULL;
# — then set this to False to stop scanning that bucket entirely.
API_KEY_LEGACY_PREFIX_FALLBACK=True

# Credential encryption — leave empty to disable BYO LLM credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
